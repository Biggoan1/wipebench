# WipeBench - default deny. This repo is SOURCE ONLY; every build artefact, driver pack and
# licensed binary is excluded. An earlier attempt used an allow-list that permitted *.txt and
# promptly swallowed a vendor licence key, so directories are excluded wholesale here.
*
!*/

!*.ps1
!*.psm1
!*.sh
!*.cmd
!*.bat
!*.md
!.gitignore
!.gitattributes

# Named single files only - NOT *.json. The driver payload's sku-index.json and the image
# manifests are build artefacts and must stay out; this one file is hand-maintained source.
!config/match-rules.json

# --- never, regardless of extension ---
# BIOS password material: derives an admin password from identifiers printed on the chassis
bios_clear.sh
bios_set.sh
bios_scripts/
bios_*.sh

# licensed vendor software and its registration details
**/lsoft/
KillDisk*
*.lic
*.key

# personal provisioning - unattend.xml carries credentials
CustomJohn/
unattend.xml

# build artefacts and driver payload
*.img
*.wim
*.iso
*.zip
*.cab
*.msi
*.exe
*.run
*.tar.gz
Drivers/
payload/
winpe/sources/
catalog/

# editing detritus - git is the history mechanism now
*.bak
*.bak-*
*.old
*.orig

# --- the build workstation's working folder holds more than the source (added 2026-09-14) ---
# C:\WipeBench-source on the build box is now a checkout of this repo, and it also holds the
# pre-git archive: stale Linux script copies, the old WinPE boot tree, catalog downloads, and
# root-level DellCleaner variants that still carry the BIOS derivation. None of it is source.
# The allow-list above admits any *.ps1 / *.sh anywhere, so these must be shut explicitly.
/Scripts/
/legacy-Boots/
/winpe-startup/
/catalog/
/*.ps1
*.live.ps1
*.patched.ps1
*.sad
capture.err
Key.txt
Disk.txt
err.txt
# point-in-time exports of customer hardware, never source
fleet-needed-*.txt
